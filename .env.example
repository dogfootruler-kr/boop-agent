# ---- Convex ----
# Get these by running: npx convex dev
# Convex will create a project and auto-populate your .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Optional server-only override. Leave commented for local Vite dev; the server
# falls back to VITE_CONVEX_URL, and Convex CLI warns if both active URL vars exist.
# CONVEX_URL=

# ---- Sendblue (iMessage bridge) ----
# Sign up at https://sendblue.com, get your API keys + provisioned number.
# Webhook URL you'll set in Sendblue dashboard:  <PUBLIC_URL>/sendblue/webhook
#
# SENDBLUE_FROM_NUMBER MUST be your Sendblue-provisioned number (the one
# people text TO), not your personal cell. Sendblue's API requires it.
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# ---- OpenWA (WhatsApp gateway) ----
# Optional. `npm run setup` lets you skip this entirely, and leaving it blank
# means the `whatsapp` channel is simply absent; nothing else changes. You run
# OpenWA yourself on always-on hardware, and Boop reaches it over your
# tailnet, so none of this needs public internet exposure.
#
# WHATSAPP_GATEWAY_URL is the gateway root on your tailnet, without a
# trailing `/api`, e.g. http://100.x.x.x:8080 (a placeholder tailnet
# address - yours comes from OpenWA's own setup).
# WHATSAPP_ALLOWLIST is the set of people Boop will accept a WhatsApp message
# from. It is a security boundary, not a filter: anyone not on it is dropped
# without a reply. Write entries as E.164 or as raw `@c.us` JIDs, separated by
# commas or newlines; both forms land on the same handle. Boop's memory is not
# scoped per person, so a second entry reads and writes the first one's
# memories - see the Allowlist section of CONTEXT.md before adding one.
# WHATSAPP_SELF_ADDRESS is an optional override for the gateway account's own
# WhatsApp address, for when it cannot be worked out from the gateway.
#
# There is no separate webhook secret to set here. Boop derives it itself
# from WHATSAPP_API_KEY, so rotating that key also rotates the derived
# secret - Boop has to re-register the webhook with OpenWA afterward (restart
# Boop), or WhatsApp messages stop arriving until it does.
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION_ID=
WHATSAPP_ALLOWLIST=
WHATSAPP_SELF_ADDRESS=

# ---- Telegram (bot gateway) ----
# Optional. Leaving TELEGRAM_BOT_TOKEN blank means the `telegram` channel is
# simply absent; nothing else changes. Unlike OpenWA there is nothing to
# self-host: the gateway is Telegram's own cloud, which calls Boop's webhook
# over the public internet, so this channel needs a working public URL
# (PUBLIC_URL, or the tunnel `npm run dev` brings up).
#
# TELEGRAM_BOT_TOKEN comes from @BotFather: /newbot, then copy the token it
# prints. It looks like 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.
# TELEGRAM_ALLOWLIST is the set of people Boop will accept a Telegram message
# from. It is a security boundary, not a filter: anyone not on it is dropped
# without a reply, and an empty allowlist drops everyone rather than admitting
# everyone. Entries are comma-separated and are either a numeric chat ID
# (123456789) or an @username. Prefer the chat ID: a username can be changed
# by its owner at any time. If you don't know your chat ID, leave this blank,
# start Boop, message the bot once, and read the ID off the `[telegram]
# dropped a message from chat ...` line in the log. Boop's memory is not
# scoped per person, so a second entry reads and writes the first one's
# memories - see the Allowlist section of CONTEXT.md before adding one.
#
# There is no webhook secret to set here. Boop derives it from
# TELEGRAM_BOT_TOKEN, so rotating the token also rotates the derived secret -
# restart Boop afterward to re-register, or Telegram messages stop arriving.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWLIST=

# ---- Voice notes (speech to text) ----
# Hold the mic button in Telegram and Boop transcribes the note, then treats
# the transcript as the message you sent. Nothing here needs setting: left
# blank, Boop transcribes in-process with Whisper via @huggingface/transformers
# (onnx-community/whisper-base, ~75MB, downloaded once into Boop's data folder
# and cached next to the embedding model). No API key, no separate server, and
# the audio never leaves your machine.
#
# BOOP_TRANSCRIBE_LANGUAGE is the one worth setting. Whisper does NOT detect
# the language here: unset means every note is decoded as English, so German
# speech comes back as confident English nonsense rather than as an error. Use
# a lowercase English name — german, french, spanish, italian, portuguese.
BOOP_TRANSCRIBE_LANGUAGE=
#
# BOOP_TRANSCRIBE_LOCAL_MODEL swaps the in-process model. Blank means
# onnx-community/whisper-base. onnx-community/whisper-small (~250MB) is
# noticeably better outside English and still fast enough to wait on.
BOOP_TRANSCRIBE_LOCAL_MODEL=
#
# ---- or hand the work to a transcriber you run ----
# Setting BOOP_TRANSCRIBE_URL switches Boop off the in-process model entirely.
# Anything speaking OpenAI's /v1/audio/transcriptions works: OpenASR, vLLM,
# Groq, OpenAI itself. This is the only way to reach a model Transformers.js
# cannot run — Qwen3-ASR among them, which is better than Whisper at this size.
#
# For Qwen3-ASR-0.6B on your own machine:
#   brew install quintinshaw/tap/openasr
#   openasr pull qwen3-asr-0.6b
#   openasr serve                    # listens on 127.0.0.1:8080
# then set:
#   BOOP_TRANSCRIBE_URL=http://127.0.0.1:8080/v1/audio/transcriptions
#   BOOP_TRANSCRIBE_MODEL=qwen3-asr-0.6b
# ffmpeg must be on the PATH openasr runs with — it decodes anything that is
# not already a WAV, and Telegram sends voice notes as Ogg/Opus.
#
# Point this at a remote host and your voice notes go there. That is the whole
# reason it is off by default.
BOOP_TRANSCRIBE_URL=
BOOP_TRANSCRIBE_MODEL=
#
# Only needed for an endpoint that authenticates. OPENAI_API_KEY is used
# automatically, but only when the URL is api.openai.com — a key you set for
# embeddings is never sent to some other host.
BOOP_TRANSCRIBE_API_KEY=

# ---- Tunnel ----
# How `npm run dev` exposes the local server so webhooks can reach it.
#
# BOOP_TUNNEL picks the provider: `ngrok`, `cloudflared`, or `none`. Left blank
# it tries ngrok first, then cloudflared, then runs without a tunnel.
#
# Both defaults hand you a NEW hostname on every restart. Boop re-registers the
# Sendblue, Telegram, and Composio webhooks each boot so that keeps working,
# but between a restart and re-registration the old hostname is dead and the
# provider logs a delivery failure against it. For a hostname that survives a
# restart, use one of the two stable options below.
#
# NGROK_DOMAIN is a reserved ngrok domain (paid): boop.ngrok.app, no scheme.
#
# CLOUDFLARE_TUNNEL is the name (or UUID) of a named Cloudflare tunnel. Unlike
# a quick tunnel this needs a domain you own on Cloudflare, and a one-time
# setup that cannot be automated because it opens a browser:
#   cloudflared tunnel login                       # pick the zone
#   cloudflared tunnel create boop
#   cloudflared tunnel route dns boop boop.yourdomain.com
# Then set CLOUDFLARE_TUNNEL=boop and PUBLIC_URL=https://boop.yourdomain.com.
# cloudflared never prints the hostname in this mode - the DNS route defines
# it - so PUBLIC_URL is what Boop registers with every provider.
BOOP_TUNNEL=
CLOUDFLARE_TUNNEL=

# BOOP_TAILNET_ADDRESS is Boop's own address on your tailnet, which OpenWA
# needs in order to know where to deliver inbound WhatsApp messages. `npm run
# setup` works this out automatically by asking the local Tailscale node, so
# leave this blank unless that discovery fails or you need to pin a specific
# address. A placeholder value looks like 100.x.x.x (Tailscale's own IPv4
# range).
BOOP_TAILNET_ADDRESS=

# ---- Agent runtime ----
# claude = Claude Agent SDK / Claude Code path. codex = local `codex app-server`
# path using the ChatGPT/Codex account from `codex login`.
BOOP_RUNTIME=claude

# ---- Claude model ----
# Uses your Claude Code subscription automatically — no separate API key needed.
# Override with ANTHROPIC_API_KEY if you want to bypass the subscription.
# This is the *fallback*; runtime overrides set via the iMessage set_model tool
# (stored in the Convex `settings` table) take precedence.
BOOP_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# ---- Codex model ----
# Used when BOOP_RUNTIME=codex or the runtime setting is switched to Codex.
# Requires `codex login` on the host. BOOP_CODEX_AUTH_HOME can point at another
# Codex home containing auth.json if needed.
BOOP_CODEX_MODEL=gpt-5.5
BOOP_CODEX_REASONING_EFFORT=medium
# BOOP_CODEX_AUTH_HOME=

# ---- Local browser use ----
# Patchright-backed Chrome profile for login-required services, visual browser
# workflows, and bot-wall-sensitive sites. Debug UI settings stored in Convex
# take precedence over these fallbacks. Off by default; enable in Settings
# before agents can see or use the local browser integration.
# BOOP_BROWSER_ENABLED=false
# BOOP_BROWSER_PROFILE_DIR=~/.boop/browser-profile
# BOOP_BROWSER_SHOW_UI=true
# BOOP_BROWSER_LOGIN_HANDOFF=false
# BOOP_BROWSER_START_URL=
# BOOP_BROWSER_CHANNEL=chrome
# BOOP_BROWSER_EXECUTABLE_PATH=
# BOOP_BROWSER_EXTRA_ARGS=

# ---- Apple data (optional) ----
# Read-only iMessage / Apple Notes / Apple Calendar / Apple Reminders access
# on the local Mac. iMessage requires Full Disk Access for the terminal/Codex
# app running `npm run dev`. Apple Notes and Apple Reminders require macOS
# Automation permission. Calendar requires the optional Apple bridge.
# BOOP_APPLE_ENABLED=false
# BOOP_APPLE_MESSAGES_ENABLED=false
# BOOP_APPLE_NOTES_ENABLED=false
# BOOP_APPLE_REMINDERS_ENABLED=false

# ---- Proactive email surfacing ----
# Phone number that receives proactive notices when the Gmail watcher decides
# an inbound email is worth surfacing. Single-user assumption for v1.
# Without this, the webhook still registers but notices are dropped.
BOOP_USER_PHONE=
# Which channel those notices go out on: `sms` (iMessage, the default) or
# `whatsapp`. It is the same phone number either way, since a handle is E.164
# on every channel. Leave it blank if you only use iMessage - nothing changes.
# Set it to `whatsapp` only once the WhatsApp channel above is configured, or
# notices have nowhere to go.
BOOP_PROACTIVE_CHANNEL=
# Set to "false" to skip auto-registering the Composio webhook URL on each
# `npm run dev`. Use when you want to manage the subscription manually.
# COMPOSIO_AUTO_WEBHOOK=

# ---- Upgrade notifications ----
# On `npm run dev`, Boop checks your `upstream` remote for new commits and
# prints a banner with the commit count + a reminder to run `/upgrade-boop`.
# Set to `false` to silence the check entirely.
# BOOP_UPSTREAM_CHECK=true

# ---- Embeddings (optional — paid providers for memory recall) ----
# Tried in order: Voyage → OpenAI → local Transformers.js (Xenova/bge-large-
# en-v1.5, 1024-dim, free, ~440MB one-time download). Leave both blank to
# use the local fallback. All three produce 1024-dim vectors so the Convex
# index stays compatible regardless of which is active.
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# ---- Server ----
PORT=3456

# Public URL for your server.
# - Leave as http://localhost:3456 if you're using free ngrok (URL changes each restart).
# - Set to your stable public URL (e.g. https://boop.mydomain.com) if you use
#   Cloudflare Tunnel, a Caddy server, or any other tunnel with a fixed URL —
#   `npm run dev` will then skip ngrok.
PUBLIC_URL=http://localhost:3456

# Optional: ngrok RESERVED domain (paid plan). Example: "boop.ngrok.app".
# When set, `npm run dev` launches ngrok with --domain=$NGROK_DOMAIN so your
# public URL stays the same across restarts.
# NGROK_DOMAIN=

# When free-plan ngrok is in use, `npm run dev` auto-registers the new tunnel
# URL with Sendblue as the inbound (receive) webhook so you don't have to
# paste it into the dashboard. Set to "false" to disable this behavior.
# SENDBLUE_AUTO_WEBHOOK=true

# ---- Composio (1000+ integrations, zero-code) ----
# Get an API key at https://app.composio.dev/developers.
# Once set, connect toolkits (Gmail, Slack, GitHub, Linear, …) from the
# Debug UI's Connections tab. Each connected toolkit becomes available to
# the agent via spawn_agent(integrations: [...]).
COMPOSIO_API_KEY=

# Optional: stable user id Composio keys connections under. Defaults to
# "boop-default". Override only if you already manage Composio sessions
# elsewhere and want Boop to reuse that user.
# COMPOSIO_USER_ID=

# --- Image retention (optional) ---
# Days to keep iMessage-received image bytes. Images referenced by a
# memory record are kept indefinitely regardless of this setting.
# Set to 0 to disable cleanup (debug only).
BOOP_IMAGE_RETENTION_DAYS=3
BOOP_IMAGE_CLEANUP_INTERVAL_MS=43200000
